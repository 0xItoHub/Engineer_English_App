    "secondaryButton": {
      "lightMode": {
        "defaults": {
          "backgroundColor": "ffffffff",
          "borderColor": "3c5aa6ff",
          "textColor": "3c5aa6ff"
        },
        "hover": {
          "backgroundColor": "eef2faff",
          "borderColor": "24385aff",
          "textColor": "24385aff"
        },
        "active": {
          "backgroundColor": "dde5f5ff",
          "borderColor": "0a1a2fff",
          "textColor": "0a1a2fff"
        }
      }
    }
