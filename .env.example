# バックエンド（Django）が参照する環境変数の一覧
# ローカル開発用の例です。`.env` にコピーして値を調整し、シェルに読み込んで使います。
#   cp .env.example .env
#   set -a; source .env; set +a
# ※ `.env` はコミットしないでください。

# --- 基本設定 ---------------------------------------------------------------

# Django の SECRET_KEY（ローカル用の任意の文字列）
# 生成例: python -c 'import secrets;print(secrets.token_urlsafe(50))'
DJANGO_SECRET_KEY=change-me-local-dev-only

# 本番（Lambda）で SSM Parameter Store から SECRET_KEY を読む場合のパラメータ名
# DJANGO_SECRET_KEY が設定されていればそちらが優先されます。ローカルでは空のままで OK
DJANGO_SECRET_KEY_SSM_PARAM=

# デバッグモード（ローカル開発では True、本番では False）
DJANGO_DEBUG=True

# 許可するホスト名（カンマ区切り）
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- データベース -----------------------------------------------------------

# SQLite ファイルのパス（未指定ならリポジトリ直下の db.sqlite3）
SQLITE_PATH=

# Lambda 起動時にイメージ内の seed DB を SQLITE_PATH へコピーするか（1=コピーする）
# lambda.py で参照。ローカル開発では使用しません（DSQL 接続時はコピーしません）
STARTUP_COPY_SEED_DB=1

# --- Aurora DSQL（任意。本番の Lambda では Terraform が設定） --------------
# 設定すると SQLite の代わりに Aurora DSQL に接続します（IAM 認証、パスワード不要）。
# ローカル開発・テストでは空のままで OK
# 例: <cluster_id>.dsql.ap-northeast-1.on.aws
DSQL_CLUSTER_ENDPOINT=

# 接続するデータベースロール（未指定なら app）
DSQL_DB_USER=

# テーブルを作成・参照するスキーマ（未指定なら app。英小文字・数字・_ のみ）
DSQL_SCHEMA=

# TLS の検証モードとルート証明書（未指定なら verify-full と OS の証明書バンドル）
DSQL_SSLMODE=
DSQL_SSLROOTCERT=

# API のトップ（/）へのアクセスの転送先（フロントエンドの URL）
DJANGO_FRONTEND_URL=http://localhost:3000/

# --- CORS / CSRF -------------------------------------------------------------

# 全オリジンを許可するか（ローカルの動作確認用。通常は False）
DJANGO_CORS_ALLOW_ALL=False

# CORS で許可するオリジン（カンマ区切り）
# フロントエンドの開発サーバは proxy 経由で API を呼ぶため、ローカルでは空で OK
# 例: http://localhost:3000
DJANGO_CORS_ALLOWED_ORIGINS=

# CSRF で信頼するオリジン（カンマ区切り）。ローカルでは空で OK
# 例: http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- 本番向けセキュリティ設定（DJANGO_DEBUG=False のときのみ有効） ---------

# HTTP を HTTPS にリダイレクトするか
DJANGO_SECURE_SSL_REDIRECT=False

# HSTS の有効期間（秒）
DJANGO_SECURE_HSTS_SECONDS=31536000

# --- CloudFront 経由のリクエストの確認（本番の Lambda では Terraform が設定） -------
# 設定すると、ヘッダー X-Origin-Verify がこの値と一致するリクエストのみを処理する。
# ローカル開発・テストでは空のままで OK
ORIGIN_VERIFY_SECRET=

# --- Amazon Cognito（ログイン） --------------------------------------------------

# アクセストークンの検証に使うユーザープール ID とアプリクライアント ID（公開情報）。
# 未設定の場合は Bearer トークンを受け付けず、すべて未ログインとして扱う
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# --- AI チャット（任意。既定は無効） ----------------------------------------------
# 接続先: disabled（既定）/ gemini / openai_compatible / bedrock。ローカルでは空のままで OK
CHAT_PROVIDER=
# モデル名（空ならアプリの既定値）
CHAT_MODEL=
# openai_compatible の接続先（/chat/completions の手前まで。例: https://api.openai.com/v1）
CHAT_API_BASE_URL=
# API キーを保存した SSM SecureString のパラメータ名（キーの値はここに書かない）
CHAT_API_KEY_SSM_PARAM=
# 上限（空なら既定値: 500 文字 / 300 トークン / 履歴 6 件 / 1 ユーザー 20 回/日 / 全体 200 回/日 / 20 秒）
CHAT_MAX_INPUT_CHARS=
CHAT_MAX_OUTPUT_TOKENS=
CHAT_MAX_HISTORY=
CHAT_USER_DAILY_LIMIT=
CHAT_GLOBAL_DAILY_LIMIT=
CHAT_TIMEOUT_SECONDS=
# 1 ユーザーあたりの短時間の質問回数（既定 6/min。変更する場合のみ指定）
# DJANGO_THROTTLE_CHAT=6/min
